package com.dam.view;

import javax.swing.BorderFactory;
import javax.swing.JButton;
import javax.swing.JFrame;
import javax.swing.JLabel;
import javax.swing.JOptionPane;
import javax.swing.JPanel;
import javax.swing.JPasswordField;
import javax.swing.JTextField;
import javax.swing.SwingConstants;
import javax.swing.SwingUtilities;

import java.awt.BorderLayout;
import java.awt.Color;
import java.awt.Cursor;
import java.awt.Font;
import java.awt.GridBagConstraints;
import java.awt.GridBagLayout;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;

public class PnlInicioSesion extends JPanel 
{
	public PnlInicioSesion() 
	{
        setLayout(new BorderLayout());
        setBackground(Color.WHITE);

        // Título
        JLabel lblTitulo = new JLabel("Iniciar Sesión", SwingConstants.CENTER);
        lblTitulo.setFont(new Font("Arial", Font.BOLD, 24));
        lblTitulo.setBorder(BorderFactory.createEmptyBorder(20, 0, 20, 0));
        add(lblTitulo, BorderLayout.NORTH);

        // Panel central con campos de texto
        JPanel panelCampos = new JPanel();
        panelCampos.setLayout(new GridBagLayout());
        panelCampos.setBackground(Color.WHITE);
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(10, 10, 10, 10);
        gbc.fill = GridBagConstraints.HORIZONTAL;

        // Usuario o Email
        gbc.gridx = 0;
        gbc.gridy = 0;
        panelCampos.add(new JLabel("Usuario o Email:"), gbc);

        gbc.gridx = 1;
        JTextField txtUsuario = new JTextField(20);
        panelCampos.add(txtUsuario, gbc);

        // Contraseña
        gbc.gridx = 0;
        gbc.gridy = 1;
        panelCampos.add(new JLabel("Contraseña:"), gbc);

        gbc.gridx = 1;
        JPasswordField txtContrasena = new JPasswordField(20);
        panelCampos.add(txtContrasena, gbc);

        // Botón Ingresar
        gbc.gridx = 0;
        gbc.gridy = 2;
        gbc.gridwidth = 2;
        gbc.anchor = GridBagConstraints.CENTER;
        JButton btnIngresar = new JButton("Ingresar");
        btnIngresar.setBackground(new Color(0, 153, 0));
        btnIngresar.setForeground(Color.WHITE);
        btnIngresar.setFocusPainted(false);
        panelCampos.add(btnIngresar, gbc);

        add(panelCampos, BorderLayout.CENTER);

        // Enlace de registro
        JLabel lblRegistro = new JLabel("¿No tienes una cuenta? Regístrate", SwingConstants.CENTER);
        lblRegistro.setForeground(Color.BLUE.darker());
        lblRegistro.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
        lblRegistro.setBorder(BorderFactory.createEmptyBorder(20, 0, 20, 0));
        lblRegistro.addMouseListener(new MouseAdapter() {
            public void mouseClicked(MouseEvent e) {
                // Acción al hacer clic en el enlace
                JOptionPane.showMessageDialog(PnlInicioSesion.this, "Redirigir a registro...");
            }
        });
        add(lblRegistro, BorderLayout.SOUTH);
    }

    // Método para probar el panel en una ventana
    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            JFrame frame = new JFrame("Login");
            frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
            frame.setContentPane(new PnlInicioSesion());
            frame.setSize(400, 300);
            frame.setLocationRelativeTo(null);
            frame.setVisible(true);
        });
    }

	public static Object getUsuarioActual() 
	{
		Object user = null;
		
		
		return user;
	}
}
